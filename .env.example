# Python runtime (optional overrides)
APP_ENV=development
# Window title override (optional)
# APP_TITLE=JOS One
# Exe filename for PyInstaller (optional)
# APP_NAME=jos-one

# Auth API for login (Python bridge calls this; used by make dev / make start)
# AUTH_API_URL=https://script.google.com/macros/s/.../exec

# Browser-only dev (make local) — optional; see frontend/.env.example
