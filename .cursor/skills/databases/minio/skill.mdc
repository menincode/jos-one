### Select API (SQL on Objects)

```python
# Query JSON/CSV objects with SQL
from minio.select import SelectRequest

request = SelectRequest(
    "SELECT * FROM S3Object[*] WHERE age > 25",
    expression_type="SQL",
    input_serialization={
        "JSON": {"Type": "DOCUMENT"}
    },
    output_serialization={
        "JSON": {"RecordDelimiter": "\n"}
    }
)

response = client.select_object_content(
    "my-bucket",
    "data.json",
    request
)

for event in response.stream():
    if event.event_type == "Records":
        print(event.data.decode())
```

### Batch Operations

```python
# Copy multiple objects
from minio.commonconfig import CopySource

sources = [
    CopySource("source-bucket", "file1.jpg"),
    CopySource("source-bucket", "file2.jpg"),
]

client.compose_object(
    "dest-bucket",
    "combined.jpg",
    sources
)
```

### Access Control

```python
# Set bucket policy (JSON policy document)
policy = {
    "Version": "2012-10-17",
    "Statement": [{
        "Effect": "Allow",
        "Principal": {"AWS": ["*"]},
        "Action": ["s3:GetObject"],
        "Resource": ["arn:aws:s3:::my-bucket/*"]
    }]
}

client.set_bucket_policy("my-bucket", json.dumps(policy))
```
