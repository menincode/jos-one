# MinIO

## Description

MinIO is a high-performance, S3-compatible object storage server. Designed for cloud-native applications, AI/ML workloads, and data lake architectures.

## When to Use

- Object storage for applications
- Data lake and analytics storage
- Backup and archival
- Media file storage
- AI/ML model storage
- Static asset hosting

---

## Core Patterns

### Client Configuration

```python
from minio import Minio
from minio.error import S3Error

# Initialize client
client = Minio(
    "localhost:9000",
    access_key="minioadmin",
    secret_key="minioadmin",
    secure=False  # Use True with TLS
)

# With TLS
client = Minio(
    "minio.example.com:9000",
    access_key="access_key",
    secret_key="secret_key",
    secure=True,
    region="us-east-1"
)
```

### Bucket Operations

```python
# Create bucket
try:
    client.make_bucket("my-bucket", location="us-east-1")
except S3Error as e:
    if e.code == "BucketAlreadyOwnedByYou":
        pass  # Bucket already exists

# Check if bucket exists
if client.bucket_exists("my-bucket"):
    print("Bucket exists")

# List buckets
buckets = client.list_buckets()
for bucket in buckets:
    print(f"Bucket: {bucket.name}, Created: {bucket.creation_date}")

# Remove bucket (must be empty)
client.remove_bucket("my-bucket")
```

### Object Operations

```python
# Upload file
client.fput_object(
    "my-bucket",
    "path/to/file.jpg",
    "/local/path/file.jpg",
    content_type="image/jpeg",
    metadata={"x-amz-meta-custom": "value"}
)

# Upload from bytes/string
from io import BytesIO

data = BytesIO(b"Hello, MinIO!")
client.put_object(
    "my-bucket",
    "path/to/object.txt",
    data,
    length=len(data.getvalue()),
    content_type="text/plain"
)

# Download object
client.fget_object(
    "my-bucket",
    "path/to/file.jpg",
    "/local/download/file.jpg"
)

# Get object as bytes
response = client.get_object("my-bucket", "path/to/object.txt")
data = response.read()
response.close()
response.release_conn()

# Delete object
client.remove_object("my-bucket", "path/to/file.jpg")

# Delete multiple objects
from minio.deleteobjects import DeleteObject

objects_to_delete = [
    DeleteObject("path/to/file1.jpg"),
    DeleteObject("path/to/file2.jpg"),
]
errors = client.remove_objects("my-bucket", objects_to_delete)
for error in errors:
    print(f"Error deleting {error}")
```

### Presigned URLs

```python
from datetime import timedelta

# Generate presigned URL for upload
url = client.presigned_put_object(
    "my-bucket",
    "path/to/upload.jpg",
    expires=timedelta(hours=1)
)

# Generate presigned URL for download
url = client.presigned_get_object(
    "my-bucket",
    "path/to/file.jpg",
    expires=timedelta(hours=1)
)

# Generate presigned POST URL (for form uploads)
from minio.commonconfig import Tags
from minio.post_policy import PostPolicy

policy = PostPolicy()
policy.set_bucket_name("my-bucket")
policy.set_key_startswith("uploads/")
policy.set_expires(datetime.utcnow() + timedelta(hours=1))

form_data = client.presigned_post_policy(policy)
```

### Object Versioning

```python
# Enable versioning on bucket
from minio.versioningconfig import VersioningConfig, ENABLED

client.set_bucket_versioning(
    "my-bucket",
    VersioningConfig(ENABLED)
)

# Upload object (creates new version)
client.put_object("my-bucket", "file.txt", data, len(data))

# List object versions
from minio.commonconfig import Tags

versions = client.list_objects(
    "my-bucket",
    prefix="file.txt",
    include_version=True
)
for obj in versions:
    print(f"Version: {obj.version_id}, IsLatest: {obj.is_latest}")

# Get specific version
response = client.get_object(
    "my-bucket",
    "file.txt",
    version_id="version-id-here"
)
```

### Object Locking (WORM)

```python
# Enable object locking on bucket
from minio.retention import Retention
from datetime import datetime, timedelta

# Set retention mode and retention until date
retention = Retention(
    mode=GOVERNANCE,  # or COMPLIANCE
    retain_until_date=datetime.utcnow() + timedelta(days=90)
)

client.set_object_retention(
    "my-bucket",
    "file.txt",
    retention
)

# Get object retention
retention = client.get_object_retention("my-bucket", "file.txt")
```

