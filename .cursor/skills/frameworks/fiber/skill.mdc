### Graceful Shutdown

```go
// cmd/server/main.go
func main() {
    app := fiber.New()
    routes.SetupRoutes(app)
    
    // Create channel for graceful shutdown
    c := make(chan os.Signal, 1)
    signal.Notify(c, os.Interrupt)
    
    go func() {
        <-c
        app.Shutdown()
    }()
    
    app.Listen(":8080")
}
```

